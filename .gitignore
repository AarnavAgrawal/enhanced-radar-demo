# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ...but the template carries no secrets and should travel with the repo.
!.env.example

# secrets, any shape
*.key
*.pem
*.p12
*.pfx
secrets.json
credentials.json
.env.local
.env.*.local

# agent + editor local config, not part of the product
CLAUDE.md
.claude/
.cursor/
.cursorrules
.aider*
.vscode/
.idea/

# os junk
Thumbs.db
desktop.ini

# local scratch
/tmp/
*.log
