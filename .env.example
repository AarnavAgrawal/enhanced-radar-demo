# Copy to .env.local and fill in. .env* is gitignored, so real keys never leave your machine.
#
# PowerShell:
#   Copy-Item .env.example .env.local
#   notepad .env.local

# --- Voice input. Optional: the app runs fine without it. ---
# Server side only. Never prefix this NEXT_PUBLIC_ -- that would ship the key
# to the browser. /api/transcribe reads it and forwards to Deepgram.
DEEPGRAM_API_KEY=

# --- Optional ADS-B fallback ---
# airplanes.live now requires per-project approval and returns HTTP 403 to
# unregistered callers. Set to 1 only once they have approved you, otherwise
# every fallback attempt just burns 8 seconds on a guaranteed rejection.
AIRPLANES_LIVE_ENABLED=0
